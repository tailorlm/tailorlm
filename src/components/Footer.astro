---
import { site, mailto } from "../config";
import { localePath, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
}

const { lang = "zh" } = Astro.props as Props;

const copy = {
  zh: {
    tagline: "量体裁模。开源 LLM 后训练、评测与交付。",
    pricing: "定价",
    contact: "联系",
    privacy: "隐私政策",
    terms: "服务条款",
    stack: "基于自研 TrainFlow 后训练框架",
  },
  en: {
    tagline: "Custom models, fitted to your business.",
    pricing: "Pricing",
    contact: "Contact",
    privacy: "Privacy",
    terms: "Terms",
    stack: "Powered by TrainFlow",
  },
} as const;

const t = copy[lang];
const mailtoHref = mailto(lang === "en" ? "TailorLM diagnostic" : "TailorLM 诊断咨询");
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="brand">TailorLM</div>
      <p class="muted">{t.tagline}</p>
    </div>

    <div class="footer-links">
      <a href={mailtoHref}>{site.email}</a>
      <a href={site.github} rel="noreferrer">GitHub</a>
      <a href={localePath(lang, "/pricing")}>{t.pricing}</a>
      <a href={localePath(lang, "/contact")}>{t.contact}</a>
      <a href={localePath(lang, "/privacy")}>{t.privacy}</a>
      <a href={localePath(lang, "/terms")}>{t.terms}</a>
    </div>

    <div class="footer-meta">
      <p>© 2026 {site.name}</p>
      <p class="muted">{t.stack}</p>
      {
        site.icp && (
          <p class="icp">
            <a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">
              {site.icp}
            </a>
          </p>
        )
      }
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 56px 0;
    background: var(--bg-soft);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 32px;
  }

  .footer-brand .brand {
    font-family: var(--font-serif);
    font-size: 24px;
    margin-bottom: 8px;
  }

  .footer-links {
    display: grid;
    gap: 8px;
    align-content: start;
    font-size: 14px;
  }

  .footer-meta {
    font-size: 13px;
    display: grid;
    gap: 6px;
    align-content: start;
    justify-items: end;
    text-align: right;
  }

  .icp {
    font-size: 12px;
  }

  .icp a {
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-meta {
      justify-items: start;
      text-align: left;
    }
  }
</style>
