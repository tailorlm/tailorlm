---
import { mailto } from "../config";
import { alternatePath, localePath, type Lang } from "../i18n";

interface Props {
  lang?: Lang;
}

const { lang = "zh" } = Astro.props as Props;

const nav = {
  zh: [
    { href: "/services", label: "服务" },
    { href: "/pricing", label: "定价" },
    { href: "/process", label: "流程" },
    { href: "/contact", label: "联系" },
  ],
  en: [
    { href: "/en/services", label: "Services" },
    { href: "/en/pricing", label: "Pricing" },
    { href: "/en/process", label: "Process" },
    { href: "/en/contact", label: "Contact" },
  ],
} as const;

const ctaLabel = lang === "en" ? "Book a diagnostic" : "预约诊断";
const mailtoHref = mailto(lang === "en" ? "TailorLM diagnostic" : "TailorLM 诊断咨询");
const current = Astro.url.pathname;
const isNotFound = current.includes("404");
const switchHref = isNotFound
  ? localePath(lang === "en" ? "zh" : "en", "/")
  : alternatePath(lang, current);
const switchLabel = lang === "en" ? "中文" : "EN";

const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={localePath(lang, "/")} aria-label="TailorLM home">
      <svg
        class="mark"
        width="24"
        height="24"
        viewBox="0 0 100 100"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M38 18H18V82H38M62 18H82V82H62"
          stroke="currentColor"
          stroke-width="10"
          stroke-linecap="butt"
          stroke-linejoin="miter"
        />
        <path
          class="accent"
          d="M23 50H32.5M77 50H67.5"
          stroke="currentColor"
          stroke-width="8"
          stroke-linecap="butt"
        />
      </svg>
      <span>TailorLM</span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {
        nav[lang].map((link) => (
          <a
            href={link.href}
            class:list={["nav-link", { active: isActive(link.href) }]}
          >
            {link.label}
          </a>
        ))
      }
      <a class="lang-switch" href={switchHref} hreflang={lang === "en" ? "zh-CN" : "en"}>
        {switchLabel}
      </a>
    </nav>

    <a class="button header-cta" href={mailtoHref}>
      {ctaLabel} <span aria-hidden="true">↗</span>
    </a>

    <details class="mobile-menu">
      <summary aria-label="Open menu">{lang === "en" ? "Menu" : "菜单"}</summary>
      <div class="mobile-panel">
        {
          nav[lang].map((link) => (
            <a
              href={link.href}
              class:list={["mobile-link", { active: isActive(link.href) }]}
            >
              {link.label}
            </a>
          ))
        }
        <a class="mobile-link" href={switchHref}>
          {lang === "en" ? "中文" : "English"}
        </a>
        <a class="button" href={mailtoHref}>{ctaLabel}</a>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 72px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-serif);
    font-size: 21px;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .brand .mark {
    color: var(--ink);
    flex-shrink: 0;
  }

  .brand .mark .accent {
    stroke: var(--accent);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-left: auto;
  }

  .nav-link {
    font-size: 14px;
    color: var(--muted);
    transition: color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--ink);
  }

  .lang-switch {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 9px;
    line-height: 1.2;
  }

  .lang-switch:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .header-cta {
    padding: 10px 16px;
    font-size: 13px;
  }

  .mobile-menu {
    display: none;
    margin-left: auto;
    position: relative;
  }

  .mobile-menu summary {
    list-style: none;
    cursor: pointer;
    font-size: 14px;
    color: var(--ink);
    padding: 8px 0;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-panel {
    position: absolute;
    right: 0;
    top: 42px;
    width: 200px;
    padding: 16px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 18px 40px rgba(18, 60, 47, 0.08);
    display: grid;
    gap: 12px;
  }

  .mobile-link {
    font-size: 14px;
    color: var(--muted);
  }

  .mobile-link.active {
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .desktop-nav,
    .header-cta {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }
</style>
