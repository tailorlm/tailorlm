---
import type { Lang } from "../i18n";

interface Package {
  name: string;
  desc: string;
  cny: string;
  usd: string;
  origCny?: string;
  origUsd?: string;
  deliver: string;
  time: string;
  gpu: string;
  featured?: boolean;
}

interface Props {
  includeMaintenance?: boolean;
  lang?: Lang;
}

const { includeMaintenance = false, lang = "en" } = Astro.props as Props;

const copy = {
  zh: {
    headers: ["服务包", "价格", "交付", "周期", "GPU"],
    labels: ["服务包", "价格", "交付", "周期", "GPU"],
    origPrefix: "原价 ",
    packages: [
      {
        name: "问题评估",
        desc: "看 3 个失败例子，先免费判断该不该训",
        cny: "免费 ¥0",
        usd: "$0 Free",
        deliver: "Go/No-Go 判断、是否真需训练（vs Prompt/RAG）、大致预算",
        time: "1–2 个工作日",
        gpu: "无",
      },
      {
        name: "基线与评测包",
        desc: "把模糊需求变成可测题目与基线跑分",
        cny: "限时 ¥10",
        usd: "$2 limited",
        origCny: "¥100",
        origUsd: "$15",
        deliver: "30–50 题独立评测集、自动评分规则、原模型基线报告（30 天内升档可抵扣）",
        time: "排队 3–7 天",
        gpu: "无",
      },
      {
        name: "LoRA 小试验",
        desc: "小规模验证微调信号，再决定是否扩大",
        cny: "限时 ¥99",
        usd: "$15 limited",
        origCny: "¥299",
        origUsd: "$45",
        deliver: "小规模高质量训练/防泄漏、LoRA adapter、训练前后同题对比、失败分析",
        time: "排队 5–10 天",
        gpu: "实报实销（0% 加价）",
      },
      {
        name: "完整交付",
        desc: "可上线验收的定制模型与全套文档",
        cny: "限时 ¥299 起",
        usd: "$45+ limited",
        origCny: "¥999 起",
        origUsd: "$149+",
        deliver: "adapter/合并模型、评测与通用回归报告、部署说明、已知局限、2 轮修改",
        time: "1–3 周",
        gpu: "实报实销（0% 加价）",
        featured: true,
      },
    ] as Package[],
    maintenance: {
      name: "月度维护",
      desc: "增量 badcase 回流与回归",
      cny: "¥99/月 起",
      usd: "$15/mo+",
      deliver: "增量数据、评测、回归、基座升级",
      time: "按月",
      gpu: "实报实销（0% 加价）",
    } as Package,
  },
  en: {
    headers: ["Service", "Price", "Deliverables", "Timeline", "GPU"],
    labels: ["Service", "Price", "Deliverables", "Timeline", "GPU"],
    origPrefix: "Reg. ",
    packages: [
      {
        name: "Problem review",
        desc: "Review 3 failure cases free before you spend anything",
        cny: "¥0 Free",
        usd: "Free ($0)",
        deliver: "Go/no-go decision, training vs Prompt/RAG fit, cost range",
        time: "1–2 business days",
        gpu: "None",
      },
      {
        name: "Baseline & eval pack",
        desc: "Turn real failures into a fixed test set and baseline score",
        cny: "¥10 limited",
        usd: "$2 limited",
        origCny: "¥100",
        origUsd: "$15",
        deliver: "30–50 held-out cases, scoring rubric, baseline report (credited within 30d)",
        time: "3–7 days (queued)",
        gpu: "None",
      },
      {
        name: "LoRA experiment",
        desc: "Validate training signal on a small dataset before scaling",
        cny: "¥99 limited",
        usd: "$15 limited",
        origCny: "¥299",
        origUsd: "$45",
        deliver: "Small leak-checked train set, LoRA adapter, before/after comparison, failure analysis",
        time: "5–10 days (queued)",
        gpu: "At cost (0% fee)",
      },
      {
        name: "Full delivery",
        desc: "A production-ready custom model and acceptance report",
        cny: "¥299+ limited",
        usd: "$45+ limited",
        origCny: "¥999+",
        origUsd: "$149+",
        deliver: "Adapter/model, eval & general regression report, deploy notes, 2 revisions",
        time: "1–3 weeks",
        gpu: "At cost (0% fee)",
        featured: true,
      },
    ] as Package[],
    maintenance: {
      name: "Monthly maintenance",
      desc: "Continuous iteration and regression",
      cny: "¥99/mo+",
      usd: "$15/mo+",
      deliver: "Incremental data, evaluation, regression, base-model upgrades",
      time: "Monthly",
      gpu: "At cost (0% fee)",
    } as Package,
  },
} as const;

const t = copy[lang];
const packages: Package[] = [...t.packages];

if (includeMaintenance) {
  packages.push(t.maintenance);
}

const primaryPrice = (pkg: Package) => (lang === "en" ? pkg.usd : pkg.cny);
const secondaryPrice = (pkg: Package) => (lang === "en" ? pkg.cny : pkg.usd);
const origPrimaryPrice = (pkg: Package) => (lang === "en" ? pkg.origUsd : pkg.origCny);
---

<table class="pricing-table">
  <thead>
    <tr>
      {t.headers.map((header) => <th>{header}</th>)}
    </tr>
  </thead>
  <tbody>
    {
      packages.map((pkg) => (
        <tr class:list={[{ featured: pkg.featured }]}>
          <td data-label={t.labels[0]}>
            <div class="package-name">{pkg.name}</div>
            <div class="package-desc">{pkg.desc}</div>
          </td>
          <td data-label={t.labels[1]}>
            <div class="price">{primaryPrice(pkg)}</div>
            <div class="price-usd">
              {origPrimaryPrice(pkg) ? (
                <>
                  {t.origPrefix}
                  <del class="orig-price">{origPrimaryPrice(pkg)}</del>
                  {" · "}
                </>
              ) : null}
              {secondaryPrice(pkg)}
            </div>
          </td>
          <td data-label={t.labels[2]}>{pkg.deliver}</td>
          <td data-label={t.labels[3]}>{pkg.time}</td>
          <td data-label={t.labels[4]}>{pkg.gpu}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .pricing-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  th {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
    padding: 0 16px 12px;
  }

  td {
    padding: 24px 16px;
    border-top: 1px solid var(--line);
    vertical-align: top;
    font-size: 14px;
    color: var(--ink-2);
  }

  .package-name {
    font-family: var(--font-serif);
    font-size: 22px;
    color: var(--ink);
    line-height: 1.1;
  }

  .package-desc {
    margin-top: 6px;
    font-size: 13px;
    color: var(--muted);
    max-width: 220px;
  }

  .price {
    font-family: var(--font-serif);
    font-size: 20px;
    color: var(--ink);
    white-space: nowrap;
  }

  .price-usd {
    margin-top: 4px;
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  .orig-price {
    opacity: 0.78;
  }

  tr.featured td {
    background: var(--white);
  }

  tr.featured td:first-child {
    border-left: 3px solid var(--accent);
    border-radius: 12px 0 0 12px;
  }

  tr.featured td:last-child {
    border-radius: 0 12px 12px 0;
  }

  @media (max-width: 820px) {
    thead {
      display: none;
    }

    tbody,
    tr,
    td {
      display: block;
      width: 100%;
    }

    tr {
      padding: 20px 0;
      border-top: 1px solid var(--line);
    }

    tr.featured {
      background: var(--white);
      border: 1px solid var(--line);
      border-left: 3px solid var(--accent);
      border-radius: 12px;
      padding: 20px;
      margin: 12px 0;
    }

    td {
      border: 0;
      padding: 4px 0;
      display: flex;
      gap: 16px;
      justify-content: space-between;
    }

    td::before {
      content: attr(data-label);
      color: var(--muted);
      font-size: 12px;
      min-width: 56px;
      flex-shrink: 0;
    }

    tr.featured td:first-child,
    tr.featured td:last-child {
      border: 0;
      border-radius: 0;
    }

    .package-desc {
      max-width: none;
    }

    td:first-child {
      display: block;
      padding-bottom: 8px;
    }

    td:first-child::before {
      display: none;
    }
  }
</style>
