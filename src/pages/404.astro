---
import Layout from "../layouts/Layout.astro";
---

<Layout title="页面不存在 — TailorLM" description="这个页面不存在。">
  <section class="not-found">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="h1">这个页面<br />不存在。</h1>
      <p class="lead">可能是链接过期，或者我们还没写这一页。</p>
      <a class="button" href="/">回首页 <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding: 120px 0;
  }

  .not-found .eyebrow {
    margin-bottom: 20px;
  }

  .not-found .h1 {
    margin-bottom: 24px;
  }

  .not-found .lead {
    margin-bottom: 32px;
  }
</style>
