---
import Layout from "../layouts/Layout.astro";
import PricingTable from "../components/PricingTable.astro";
import FAQ from "../components/FAQ.astro";
import { mailto } from "../config";
import "../styles/en-pages.css";

const mailtoHref = mailto("TailorLM free problem review");

const faqs = [
  {
    q: "Why is GPU cost not included?",
    a: "Training time and GPU type depend on model size, dataset size, and experiment count. Small local runs incur $0 cloud GPU fee. If larger cloud GPUs are needed, they run on your cloud account or within a written SOW cap billed at pure cost (0% markup) at final settlement.",
  },
  {
    q: "What is the difference between the free review and the $2 baseline pack?",
    a: "The free review is an asynchronous expert assessment of your 3 failure examples and use case (Go/No-Go and budget range, no model runs). The $2 queued baseline pack delivers an actual 30–50 case held-out test set, scoring rules, and a measured baseline report — paid at the end when delivered.",
  },
  {
    q: "When do we pay, and how does the queue work?",
    a: "Consult first, pay on delivery. Every order starts with a free email review to agree scope and acceptance metrics with zero upfront service deposit; you settle the invoice at the end upon delivery/acceptance (final weights and source bundle transfer upon settlement). Limited-time queued tiers ($2 baseline, $15 experiment) are email-async without live calls, prioritized by tier and scope clarity; regular pricing skips the queue.",
  },
  {
    q: "Is our data safe?",
    a: "Client data never enters git. It lives in encrypted object storage, referenced by manifest and hash. Training and evaluation are isolated, and data is deleted or archived as agreed at the end of the project.",
  },
  {
    q: "How long does delivery take?",
    a: "Free problem review: 1–2 business days. Baseline & eval pack: 3–7 days (queued). LoRA experiment: 5–10 days (queued). Full delivery: 1–3 weeks. Regular-priced orders receive priority scheduling.",
  },
  {
    q: "Do you have public case studies?",
    a: "We do not publish unverified work. Redacted case studies and benchmark metrics are published only after delivery and written permission.",
  },
];
---

<Layout
  lang="en"
  title="Pricing — TailorLM"
  description="TailorLM pricing: consult first, pay on delivery. Free problem review ($0), queued baseline & eval pack $2 (reg. $15), LoRA experiment $15 (reg. $45), full delivery $45+ (reg. $149+). GPU billed at 0% markup."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">PRICING</p>
      <h1 class="h1">Consult free first.<br />Pay at the end.</h1>
      <p class="lead">
        Start with a free problem review, confirm scope and acceptance metrics in writing with $0 service deposit, and pay at delivery (including the $2 queued baseline pack, credited in full toward full delivery within 30 days). Cloud GPU billed at 0% markup.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <PricingTable lang="en" includeMaintenance />
    </div>
  </section>

  <section class="section">
    <div class="container notes-grid">
      <div>
        <div class="section-label"><span class="num">01</span><span class="txt">Billing &amp; queue rules</span></div>
        <h2 class="h2">No “one price,<br />train until satisfied”.</h2>
        <p class="lead">
          Consult first via email, lock acceptance criteria in the SOW, and settle fees at the end upon delivery. Limited-time tiers run in an async queue prioritized by tier and scope clarity; regular pricing skips the queue.
        </p>
      </div>
      <div class="notes-list">
        <div><span>Problem review</span><p>Free ($0). Send 3 real failure examples for a Go/No-Go reply before committing to anything.</p></div>
        <div><span>Baseline credit</span><p>$2 baseline covers 30–50 held-out cases on an open-source base or your API (one per client); paid on delivery and credited in full toward full delivery within 30 days.</p></div>
        <div><span>Queue &amp; priority</span><p>Limited prices are email-async queued (no calls), prioritized by budget tier and clear task scope. Regular pricing receives immediate priority.</p></div>
        <div><span>Payment</span><p>Consult first, zero upfront service deposit. Service fees settle at the end upon delivery/acceptance; final model weights and full source bundle transfer on settlement (full delivery includes 2 revision rounds).</p></div>
        <div><span>GPU cost</span><p>Local small runs incur $0 cloud GPU fee. Cloud GPUs run on your account or within a pre-agreed SOW cap at 0% markup, settled against actual bills at delivery.</p></div>
        <div><span>Taxes</span><p>Prices exclude applicable taxes. Where tax is required, it is added to the invoice.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cost-grid">
      <div>
        <div class="section-label"><span class="num">02</span><span class="txt">Cost logic</span></div>
        <h2 class="h2">Why it can<br />cost this little.</h2>
      </div>
      <div class="cost-list">
        <div>
          <span>Automated pipeline</span>
          <strong>Built-in tooling</strong>
          <p>Evaluation, leak-free data synthesis, LoRA training, and regression checks are scripted end-to-end — you do not pay inflated consulting day-rates.</p>
        </div>
        <div>
          <span>Async priority queue</span>
          <strong>Zero meeting overhead</strong>
          <p>Structured 7-question email intake eliminates sync calls. Higher-paid tiers and clean scopes move first; regular pricing skips the queue.</p>
        </div>
        <div>
          <span>GPU cost</span>
          <strong>At cost (0% markup)</strong>
          <p>Cloud compute runs on your account or under a hard SOW cap with zero markup — settled on real bills instead of padded compute estimates.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container faq-wrap">
      <div>
        <div class="section-label"><span class="num">03</span><span class="txt">FAQ</span></div>
        <h2 class="h2">Get the numbers<br />straight.</h2>
      </div>
      <FAQ items={faqs} />
    </div>
  </section>

  <section class="section">
    <div class="container cta-panel">
      <div>
        <p class="eyebrow">START FREE</p>
        <h2 class="h2">Free review first,<br />then decide.</h2>
        <p class="lead">Send your use case, data rights, and 3 real failure examples. We will return an honest Go/No-Go and cost range.</p>
      </div>
      <a class="button light" href={mailtoHref}>Free problem review <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Layout>
