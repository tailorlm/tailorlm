---
import Layout from "../layouts/Layout.astro";
import { mailto } from "../config";
import "../styles/en-pages.css";

const mailtoHref = mailto("TailorLM free problem review");

const services = [
  {
    n: "01",
    name: "Problem review (Free)",
    desc: "Review 3 real failure examples for free before spending anything.",
    price: "Free ($0)",
    cny: "¥0 · Consult first",
    time: "1–2 business days",
    deliverables: [
      "Root-cause triage: knowledge gap (RAG), behavior/tone (SFT), or workflow issue",
      "Initial testability and data readiness check",
      "Recommended next package and realistic budget range",
      "Honest Go/No-Go: if prompts/RAG are enough, we tell you not to train",
    ],
    fit: "You see model failures and want an experienced, free second opinion on whether fine-tuning makes sense.",
    notIncluded: "Running model inference, writing full test sets, data cleaning, or training.",
  },
  {
    n: "02",
    name: "Baseline & eval pack",
    desc: "Turn real failure cases into a fixed 30–50 case test set and measured baseline score.",
    price: "$2 limited",
    cny: "¥10（reg. $15 / ¥100）",
    time: "3–7 days (queued)",
    deliverables: [
      "30–50 held-out test cases and automated scoring rubric",
      "Measured baseline score using an open-source base model or your API",
      "Dimension breakdown and representative failure cases",
      "Fee credited in full toward full delivery within 30 days",
    ],
    fit: "You want a real held-out ruler and baseline numbers at minimal cost before investing in training.",
    notIncluded: "Async email queue delivery only (no live calls); 1 per client; large-scale cleaning or model training.",
  },
  {
    n: "03",
    name: "LoRA experiment",
    desc: "Validate the training direction on a small, leak-checked sample before scaling.",
    price: "$15 limited",
    cny: "¥99（reg. $45 / ¥299）",
    time: "5–10 days (queued)",
    deliverables: [
      "Small high-quality dataset curation / deduplication / anti-leak check",
      "LoRA / QLoRA / SFT training run and experiment log",
      "Before/after comparison on the fixed test set",
      "Failure analysis and scale / adjust / stop recommendation",
    ],
    fit: "You want empirical signal that LoRA improves your metric before committing to full delivery.",
    notIncluded: "Full production polish, multiple revision rounds, or ongoing maintenance. GPU billed at 0% markup (no cloud fee on local runs).",
  },
  {
    n: "04",
    name: "Full delivery",
    desc: "A production-ready custom model, with held-out evaluation, general regression, and deployment notes.",
    price: "$45+ limited",
    cny: "¥299+（reg. $149+ / ¥999+）",
    time: "1–3 weeks",
    deliverables: [
      "Curated redacted training dataset + LoRA adapter or merged model",
      "Independent evaluation report + general capability regression check",
      "Minimal runnable inference example & hardware/deployment notes",
      "Known limitations list + two revision rounds tied to eval findings",
    ],
    fit: "You have an acceptance target and need reproducible artifacts you can ship in production.",
    notIncluded: "24/7 hosting, unlimited retraining, or uncontracted scope. Cloud GPU passed through at cost (0% markup).",
  },
];
---

<Layout
  lang="en"
  title="Services — TailorLM"
  description="TailorLM services: free problem review ($0), $2 limited queued baseline & eval pack (reg. $15), $15 LoRA experiment (reg. $45), $45+ full delivery (reg. $149+)."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">SERVICES</p>
      <h1 class="h1">Free review first.<br />Then let numbers lead.</h1>
      <p class="lead">
        Not every problem needs training. Send three real failures for a free Go/No-Go, spend $2 to lock a baseline ruler in the async queue, and scale only when evidence shows up.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container service-list">
      {
        services.map((service) => (
          <article class="service-item">
            <div class="service-head">
              <span class="n">{service.n}</span>
              <div class="service-title">
                <h2 class="h3">{service.name}</h2>
                <p class="service-desc">{service.desc}</p>
              </div>
              <div class="service-price">
                <strong>{service.price}</strong>
                <span>{service.cny}</span>
                <span class="time">{service.time}</span>
              </div>
            </div>
            <div class="service-body">
              <div>
                <h4>Deliverables</h4>
                <ul>
                  {service.deliverables.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <div>
                <h4>Who it fits</h4>
                <p>{service.fit}</p>
              </div>
              <div>
                <h4>Not included</h4>
                <p>{service.notIncluded}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container choose-grid">
      <div>
        <div class="section-label"><span class="num">→</span><span class="txt">How to choose</span></div>
        <h2 class="h2">Not sure where<br />to start?</h2>
      </div>
      <div class="choose-list">
        <div><span>Not sure training is worth it</span><strong>Problem review (Free $0)</strong></div>
        <div><span>No test set or baseline score yet</span><strong>Baseline &amp; eval pack ($2 queued)</strong></div>
        <div><span>Want quick empirical signal</span><strong>LoRA experiment ($15 queued)</strong></div>
        <div><span>Need a production model &amp; regression check</span><strong>Full delivery ($45+)</strong></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cta-panel">
      <div>
        <p class="eyebrow">START FREE</p>
        <h2 class="h2">Send three real<br />failure examples.</h2>
        <p class="lead">
          Describe the task, current model, and three real failures. We will review it for free within 1–2 business days and tell you if fine-tuning fits.
        </p>
      </div>
      <a class="button light" href={mailtoHref}>Free problem review <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Layout>
