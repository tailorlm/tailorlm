---
import Layout from "../layouts/Layout.astro";

const mailto =
  "mailto:contact@mcocdaa.com?subject=" +
  encodeURIComponent("TailorLM 诊断咨询");

const services = [
  {
    n: "01",
    name: "诊断",
    desc: "判断这个问题是否真的需要训练，以及值不值得做。",
    price: "¥4,800",
    usd: "$700",
    time: "3–5 天",
    deliverables: [
      "需求分析：问题、频率、影响、当前绕过方式",
      "数据 readiness：数量、质量、权属、评测集",
      "基线方案：用什么模型、什么指标、怎么测",
      "成本预估：数据、训练、评测、云 GPU",
      "go/no-go：训练、Prompt/RAG、工作流，还是先别做",
    ],
    fit: "想训练但不确定值不值得；试过 Prompt/RAG 还是不稳定；有数据但没有评测标准。",
    not: "数据清洗、正式训练、模型部署。",
  },
  {
    n: "02",
    name: "数据与评测包",
    desc: "把资料变成可训练、可验证的数据。",
    price: "¥16,800",
    usd: "$2,500",
    time: "1–2 周",
    deliverables: [
      "清洗、去重、脱敏、格式校验",
      "训练集 / 评测集隔离",
      "评测 item 和评分规则",
      "数据质量报告和权属记录",
    ],
    fit: "有原始资料但没有可训练数据；没有独立测试集；不确定数据质量够不够。",
    not: "训练、模型交付、线上部署。",
  },
  {
    n: "03",
    name: "LoRA 小试验",
    desc: "小规模验证方向是否有效，再决定要不要扩大。",
    price: "¥28,800",
    usd: "$4,000",
    time: "1–2 周",
    deliverables: [
      "LoRA / QLoRA / SFT 小试验",
      "训练前后对比",
      "失败案例分析",
      "是否值得扩大数据/算力的建议",
    ],
    fit: "想先验证方向；预算有限；不确定 LoRA 够不够；不想一上来跑完整训练。",
    not: "正式训练、完整交付、长期维护。GPU 实报实销。",
  },
  {
    n: "04",
    name: "完整交付",
    desc: "可用的定制模型，加上可复现的评测和部署说明。",
    price: "¥68,000 起",
    usd: "$9,500 起",
    time: "3–6 周",
    deliverables: [
      "adapter 或合并模型",
      "独立评测报告：基线、训练后、回归、失败案例",
      "推理示例和部署说明",
      "已知局限和风险",
      "约定轮次的支持",
    ],
    fit: "有明确验收指标；要上线；需要可复现的交付和部署方案。",
    not: "24/7 托管、无限制重训、新增需求。GPU 实报实销。",
  },
];
---

<Layout
  title="服务 — TailorLM"
  description="TailorLM 的四种服务：诊断、数据与评测包、LoRA 小试验、完整交付。先诊断，再训练，用可复现的评测验收。"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">SERVICES</p>
      <h1 class="h1">从诊断开始，<br />按结果往下走。</h1>
      <p class="lead">
        四种合作方式。不是每个问题都需要训练；先从诊断开始，确认问题、数据和验收指标，再决定走到哪一步。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container service-list">
      {
        services.map((service) => (
          <article class="service-item">
            <div class="service-head">
              <span class="n">{service.n}</span>
              <div class="service-title">
                <h2 class="h3">{service.name}</h2>
                <p class="service-desc">{service.desc}</p>
              </div>
              <div class="service-price">
                <strong>{service.price}</strong>
                <span>{service.usd}</span>
                <span class="time">{service.time}</span>
              </div>
            </div>

            <div class="service-body">
              <div>
                <h4>交付</h4>
                <ul>
                  {service.deliverables.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <div>
                <h4>适合谁</h4>
                <p>{service.fit}</p>
              </div>
              <div>
                <h4>不包含</h4>
                <p>{service.not}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container choose-grid">
      <div>
        <div class="section-label"><span class="num">→</span><span class="txt">怎么选</span></div>
        <h2 class="h2">不确定从哪开始？<br />先做诊断。</h2>
      </div>
      <div class="choose-list">
        <div><span>不确定值不值得训练</span><strong>诊断</strong></div>
        <div><span>数据乱、没有测试集</span><strong>数据与评测包</strong></div>
        <div><span>想先验证方向</span><strong>LoRA 小试验</strong></div>
        <div><span>要上线、要可复现交付</span><strong>完整交付</strong></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cta-panel">
      <div>
        <p class="eyebrow">START HERE</p>
        <h2 class="h2">先聊聊你的场景。</h2>
        <p class="lead">告诉我们模型现在哪里不好、数据大概什么情况、什么结果算成功。没有测试集也没关系，诊断会帮你一起定义。</p>
      </div>
      <a class="button light" href={mailto}>预约诊断 <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 80px 0 72px;
  }

  .page-hero .eyebrow {
    margin-bottom: 20px;
  }

  .page-hero .h1 {
    margin-bottom: 28px;
  }

  .service-list {
    display: grid;
    gap: 0;
  }

  .service-item {
    border-top: 1px solid var(--line);
    padding: 40px 0;
  }

  .service-head {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: 24px;
    align-items: start;
  }

  .service-head .n {
    font-size: 12px;
    color: var(--accent);
    font-weight: 600;
    padding-top: 8px;
  }

  .service-title h2 {
    margin-bottom: 8px;
  }

  .service-desc {
    color: var(--muted);
    font-size: 15px;
    max-width: 520px;
  }

  .service-price {
    display: grid;
    gap: 2px;
    justify-items: end;
    text-align: right;
    white-space: nowrap;
  }

  .service-price strong {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 500;
  }

  .service-price span {
    font-size: 12px;
    color: var(--muted);
  }

  .service-price .time {
    margin-top: 6px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 9px;
    color: var(--ink);
  }

  .service-body {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 0.8fr;
    gap: 32px;
    margin: 28px 0 0 72px;
  }

  .service-body h4 {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
    font-weight: 600;
  }

  .service-body ul {
    display: grid;
    gap: 6px;
  }

  .service-body li {
    font-size: 14px;
    color: var(--ink-2);
    padding-left: 14px;
    position: relative;
  }

  .service-body li::before {
    content: "·";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .service-body p {
    font-size: 14px;
    color: var(--muted);
  }

  .choose-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }

  .choose-list {
    border-top: 1px solid var(--line);
  }

  .choose-list div {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
  }

  .choose-list span {
    color: var(--muted);
  }

  .choose-list strong {
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }

  .cta-panel {
    background: var(--ink);
    color: var(--bg);
    border-radius: 28px;
    padding: 56px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
  }

  .cta-panel .eyebrow {
    color: rgba(247, 243, 234, 0.55);
    margin-bottom: 18px;
  }

  .cta-panel .h2 {
    color: var(--bg);
  }

  .cta-panel .lead {
    color: rgba(247, 243, 234, 0.72);
    margin-top: 20px;
    max-width: 560px;
    font-size: 16px;
  }

  .button.light {
    background: var(--bg);
    color: var(--ink);
    border-color: var(--bg);
    flex-shrink: 0;
  }

  .button.light:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  @media (max-width: 900px) {
    .service-head {
      grid-template-columns: 32px 1fr;
    }

    .service-price {
      grid-column: 2;
      justify-items: start;
      text-align: left;
      margin-top: 8px;
    }

    .service-body {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-left: 56px;
    }

    .choose-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .cta-panel {
      flex-direction: column;
      align-items: start;
      padding: 40px;
    }
  }

  @media (max-width: 640px) {
    .page-hero {
      padding: 56px 0;
    }

    .service-head {
      grid-template-columns: 1fr;
    }

    .service-price {
      grid-column: 1;
    }

    .service-body {
      margin-left: 0;
    }

    .cta-panel {
      padding: 28px;
    }
  }
</style>
