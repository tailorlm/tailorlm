---
import Layout from "../layouts/Layout.astro";
import CopyButton from "../components/CopyButton.astro";
import IntakeBuilder from "../components/IntakeBuilder.astro";
import { site, mailto } from "../config";
import "../styles/en-pages.css";

const intakeBody = `1. What is the product, and who is it for?
2. Where does the model fail? Three real examples:
3. Current model / setup:
4. Data: volume, format, rights, labels
5. Acceptance metric: current value and target
6. Who signs off, deployment environment, latency / VRAM / cost limits
7. Timeline and budget range:`;

const mailtoHref = mailto("TailorLM free problem review", intakeBody);
---

<Layout
  lang="en"
  title="Contact — TailorLM"
  description="Get a free TailorLM problem review. Send 3 real failure examples and your data summary to get a Go/No-Go and budget range."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">CONTACT</p>
      <h1 class="h1">Free review first.<br />Train only if it makes sense.</h1>
      <p class="lead">
        Send 3 real model failures, your data summary, and what “better” looks like. The initial problem review is free ($0); if you want a test set and measured score, move to the $2 queued baseline pack.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-card">
        <p class="eyebrow">EMAIL</p>
        <a class="email" href={mailtoHref}>{site.email}</a>
        <p class="muted">
          The link opens an email with the 7 questions prefilled. Consult first by email, confirm scope with $0 upfront service deposit, and settle fees at the end upon delivery. Limited prices run via async queue, prioritized by tier and clarity of scope.
        </p>
        <div class="contact-actions">
          <a class="button light" href={mailtoHref}>Send 3 failure cases <span aria-hidden="true">↗</span></a>
          <CopyButton
            copy={site.email}
            done="Email copied ✓"
            fail="Copy failed"
            variantClass="ghost-light"
          >
            Copy email
          </CopyButton>
        </div>
        <div class="contact-meta">
          <div><span>Response</span><strong>1–2 business days</strong></div>
          <div><span>Problem review</span><strong>Free ($0)</strong></div>
          <div><span>Baseline pack</span><strong>$2 limited (reg. $15)</strong></div>
        </div>
      </div>

      <div class="intake">
        <div class="section-label"><span class="num">01</span><span class="txt">Structured intake</span></div>
        <h2 id="intake-heading" class="h3">Seven details that speed up your free review.</h2>
        <IntakeBuilder lang="en" headingId="intake-heading" />
        <p class="small muted note">
          Please do not send unredacted client data, chat logs, or secrets in the first email. Start with the use case, metric, and data rights; we will set up a secure channel if the data needs review.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container policy-grid">
      <article class="policy-card">
        <span class="n">01</span>
        <h3>Data never enters git</h3>
        <p>Client data lives in object storage; the repository stores only the manifest, hash, and pointer. Data is deleted or archived as agreed at the end.</p>
      </article>
      <article class="policy-card">
        <span class="n">02</span>
        <h3>Training and evaluation are isolated</h3>
        <p>The test set never enters training. Data is not mixed across clients or reused for another project.</p>
      </article>
      <article class="policy-card">
        <span class="n">03</span>
        <h3>Acceptance is in the SOW</h3>
        <p>Metrics, test set, revision rounds, and cloud caps are written down before work starts. No “it feels better” acceptance.</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container cta-panel">
      <div>
        <p class="eyebrow">NOT SURE YET?</p>
        <h2 class="h2">Not sure training<br />is the answer?</h2>
        <p class="lead">Start with a free problem review. If prompt engineering, RAG, or a workflow change is enough, we will say so.</p>
      </div>
      <a class="button light" href={mailtoHref}>Free problem review <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Layout>
