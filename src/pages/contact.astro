---
import Layout from "../layouts/Layout.astro";
import { site, mailto } from "../config";

const intakeBody = `1. 产品是什么：
2. 模型现在哪里不好（3 个真实失败例子）：
3. 当前模型/方案：
4. 数据情况（数量、格式、权属）：
5. 验收指标（现在多少，目标多少）：
6. 谁验收、部署环境、延迟/显存/成本限制：
7. 时间和预算范围：`;

const mailtoHref = mailto("TailorLM 诊断咨询", intakeBody);

const questions = [
  "你的产品是什么，用户是谁？",
  "模型现在哪里不好？给 3 个真实失败例子。",
  "现在用什么模型/方案？试过 Prompt、RAG 或微调吗？",
  "有多少数据？什么格式？有标注吗？数据权属清楚吗？",
  "什么指标算成功？现在是多少，目标是多少？",
  "谁验收？模型最终跑在哪里？有延迟/显存/成本限制吗？",
  "时间和预算范围？",
];
---

<Layout
  title="联系 — TailorLM"
  description="预约 TailorLM 诊断：告诉我们你的场景、数据和验收标准。先判断是否值得训练，再决定是否合作。"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">CONTACT</p>
      <h1 class="h1">先做诊断，<br />再决定是否训练。</h1>
      <p class="lead">
        告诉我们模型现在哪里不好、数据大概什么情况、什么结果算成功。没有测试集也没关系，诊断会帮你一起定义。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-card">
        <p class="eyebrow">EMAIL</p>
        <a class="email" href={mailtoHref}>{site.email}</a>
        <p class="muted">
          点击会打开一封预填好问题的邮件。也可以直接复制邮箱，写清楚你的场景即可。
        </p>
        <a class="button light" href={mailtoHref}>写一封诊断邮件 <span aria-hidden="true">↗</span></a>
        <div class="contact-meta">
          <div><span>响应时间</span><strong>1–2 个工作日</strong></div>
          <div><span>诊断周期</span><strong>3–5 天</strong></div>
          <div><span>诊断费</span><strong>¥4,800 起</strong></div>
        </div>
      </div>

      <div class="intake">
        <div class="section-label"><span class="num">01</span><span class="txt">邮件里写什么</span></div>
        <h2 class="h3">七个问题，帮我们快速判断。</h2>
        <ol>
          {questions.map((question) => <li>{question}</li>)}
        </ol>
        <p class="small muted note">
          首封邮件请不要发送未脱敏的客户数据、聊天记录或密钥。先聊场景、指标和数据权属；需要看数据时再走安全渠道。
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container policy-grid">
      <article class="policy-card">
        <span class="n">01</span>
        <h3>数据不进 git</h3>
        <p>客户数据只放对象存储，仓库只存 manifest、hash 和指针。项目结束按约定删除。</p>
      </article>
      <article class="policy-card">
        <span class="n">02</span>
        <h3>训练/评测隔离</h3>
        <p>评测集不参与训练；不跨客户混用数据；不把客户数据用于其他项目。</p>
      </article>
      <article class="policy-card">
        <span class="n">03</span>
        <h3>验收写进 SOW</h3>
        <p>指标、测试集、修改轮次和云成本上限提前写清楚，不用“感觉”验收。</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container cta-panel">
      <div>
        <p class="eyebrow">NOT SURE YET?</p>
        <h2 class="h2">不确定要不要训练？</h2>
        <p class="lead">先做诊断。如果 Prompt、RAG 或工作流能解决，我们会直接说。</p>
      </div>
      <a class="button light" href={mailtoHref}>预约诊断 <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 80px 0 64px;
  }

  .page-hero .eyebrow {
    margin-bottom: 20px;
  }

  .page-hero .h1 {
    margin-bottom: 28px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 64px;
    align-items: start;
  }

  .contact-card {
    background: var(--ink);
    color: var(--bg);
    border-radius: 24px;
    padding: 40px;
    display: grid;
    gap: 20px;
    align-content: start;
  }

  .contact-card .eyebrow {
    color: rgba(247, 243, 234, 0.55);
  }

  .email {
    font-family: var(--font-serif);
    font-size: clamp(24px, 3vw, 34px);
    color: var(--bg);
    word-break: break-all;
  }

  .email:hover {
    color: var(--accent);
  }

  .contact-card .muted {
    color: rgba(247, 243, 234, 0.66);
    font-size: 14px;
  }

  .contact-card .button {
    justify-self: start;
    margin-top: 8px;
  }

  .button.light {
    background: var(--bg);
    color: var(--ink);
    border-color: var(--bg);
  }

  .button.light:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .contact-meta {
    display: grid;
    gap: 12px;
    margin-top: 8px;
    padding-top: 20px;
    border-top: 1px solid rgba(247, 243, 234, 0.18);
  }

  .contact-meta div {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    font-size: 13px;
  }

  .contact-meta span {
    color: rgba(247, 243, 234, 0.55);
  }

  .intake h2 {
    margin-bottom: 20px;
  }

  .intake ol {
    counter-reset: item;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .intake li {
    counter-increment: item;
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    color: var(--ink-2);
  }

  .intake li::before {
    content: counter(item, decimal-leading-zero);
    color: var(--accent);
    font-size: 11px;
    font-weight: 600;
    padding-top: 3px;
  }

  .note {
    margin-top: 20px;
    max-width: 640px;
  }

  .policy-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .policy-card {
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }

  .policy-card .n {
    font-size: 11px;
    color: var(--accent);
    font-weight: 600;
  }

  .policy-card h3 {
    font-size: 22px;
    margin: 16px 0 8px;
  }

  .policy-card p {
    font-size: 14px;
    color: var(--muted);
  }

  .cta-panel {
    background: var(--ink);
    color: var(--bg);
    border-radius: 28px;
    padding: 56px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
  }

  .cta-panel .eyebrow {
    color: rgba(247, 243, 234, 0.55);
    margin-bottom: 18px;
  }

  .cta-panel .h2 {
    color: var(--bg);
  }

  .cta-panel .lead {
    color: rgba(247, 243, 234, 0.72);
    margin-top: 20px;
    max-width: 560px;
    font-size: 16px;
  }

  @media (max-width: 900px) {
    .contact-grid,
    .policy-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .contact-card {
      padding: 32px;
    }

    .cta-panel {
      flex-direction: column;
      align-items: start;
      padding: 40px;
    }
  }

  @media (max-width: 640px) {
    .page-hero {
      padding: 56px 0;
    }

    .contact-card {
      padding: 24px;
    }

    .cta-panel {
      padding: 28px;
    }
  }
</style>
