---
import Layout from "../../layouts/Layout.astro";
import PricingTable from "../../components/PricingTable.astro";
import FAQ from "../../components/FAQ.astro";
import { mailto } from "../../config";
import "../../styles/en-pages.css";

const mailtoHref = mailto("TailorLM free problem review");

const faqs = [
  {
    q: "Why review the problem for free before training?",
    a: "Not every problem should be solved by training. Send three real failure examples and we will tell you whether the gap is missing knowledge (RAG), model behavior (SFT), or workflow design. If prompt engineering or RAG is enough, we will say so instead of selling training.",
  },
  {
    q: "How is the $2 limited queued baseline pack sustainable?",
    a: "It is delivered asynchronously over email in a queue (no live calls), scoped to 30–50 held-out cases scored with our automated pipeline on an open-source base model or your API (one per client). Priority goes to higher-paid tiers and cleanly scoped requests.",
  },
  {
    q: "Do you have public case studies?",
    a: "We do not publish unverified work. Client projects are published in redacted form only after delivery and written permission.",
  },
  {
    q: "Is our data safe?",
    a: "Client data never enters git. It lives in encrypted object storage, referenced by manifest and hash. Training and evaluation are isolated, and data is deleted or archived as agreed at the end of the project. Please do not send unredacted data or secrets in the first email.",
  },
];
---

<Layout
  lang="en"
  title="TailorLM — Post-training for open-source LLMs"
  description="TailorLM is a post-training studio for open-source LLMs. Start with a free problem review, run a $2 limited queued baseline, and accept on a held-out test set."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">LLM POST-TRAINING STUDIO</p>
        <h1 class="h1">Your model,<br />fitted to your product.</h1>
        <p class="lead">
          TailorLM helps teams with a clear task and real data post-train open-source LLMs.
          Start with a free problem review, lock a $2 baseline test set, and accept on reproducible metrics.
        </p>
        <div class="hero-actions">
          <a class="button" href={mailtoHref}>Free review <span aria-hidden="true">↗</span></a>
          <a class="button secondary" href="/en/pricing">Services &amp; pricing</a>
        </div>
        <p class="small muted hero-note">Free Go/No-Go problem review · Baseline &amp; eval pack $2 limited queued (reg. $15)</p>
      </div>

      <aside class="hero-card" aria-label="Free review">
        <div class="card-head"><span>TAILORLM / FREE REVIEW</span><span>01</span></div>
        <h2 class="card-title">Free review first.<br />Then decide.</h2>
        <ul class="check-list">
          <li>Send 3 real failures — check for free if training is the right fix</li>
          <li>Check data volume and rights</li>
          <li>Define the test set and acceptance metric</li>
          <li>Get an honest cost range before spending anything</li>
        </ul>
        <div class="card-foot"><span>1–2 business days</span><span>Free ($0)</span></div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-label"><span class="num">01</span><span class="txt">What usually goes wrong</span></div>
      <div class="grid-4 problem-grid">
        <article class="problem-card">
          <span class="n">A</span>
          <h3>It doesn't sound like your brand</h3>
          <p>Tone, forms of address, and boundaries drift; it sounds like a generic assistant.</p>
        </article>
        <article class="problem-card">
          <span class="n">B</span>
          <h3>It drifts in long conversations</h3>
          <p>By turn ten it forgets who it is, what it can do, and what it must not do.</p>
        </article>
        <article class="problem-card">
          <span class="n">C</span>
          <h3>Structured output and tool calls are unstable</h3>
          <p>JSON, arguments, and refusal boundaries fail; retries don't fix it.</p>
        </article>
        <article class="problem-card">
          <span class="n">D</span>
          <h3>Prompt and RAG were already tried</h3>
          <p>Knowledge improved, but behavior and voice are still inconsistent.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container deliver-grid">
      <div class="deliver-intro">
        <div class="section-label"><span class="num">02</span><span class="txt">What you get</span></div>
        <h2 class="h2">Not “training finished”.<br />“It measurably got better.”</h2>
        <p class="lead">
          The business metric, the regression result, and a model you can actually run matter more than a loss curve.
        </p>
      </div>

      <div class="deliver-list">
        <article class="deliver-item">
          <span class="n">01</span>
          <div>
            <h3>One business metric</h3>
            <p>From A to B, written into the SOW before training; no moving the goalposts.</p>
          </div>
        </article>
        <article class="deliver-item">
          <span class="n">02</span>
          <div>
            <h3>A fixed test set</h3>
            <p>The same questions and rubric before and after; reproducible.</p>
          </div>
        </article>
        <article class="deliver-item">
          <span class="n">03</span>
          <div>
            <h3>Regression testing</h3>
            <p>The target improves without the model getting noticeably worse elsewhere.</p>
          </div>
        </article>
        <article class="deliver-item">
          <span class="n">04</span>
          <div>
            <h3>Artifacts you can use</h3>
            <p>Adapter or model, inference example, deployment notes, failure cases, and limitations.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-label"><span class="num">03</span><span class="txt">How it runs</span></div>
      <div class="process-grid">
        <article class="process-step">
          <span class="n">01</span>
          <h3>Free review</h3>
          <p>Check 3 failure cases; decide whether training makes sense.</p>
          <span class="time">1–2 business days · $0</span>
        </article>
        <article class="process-step">
          <span class="n">02</span>
          <h3>Baseline &amp; eval</h3>
          <p>Build 30–50 held-out cases and measure the base model.</p>
          <span class="time">3–7 days (queued) · $2</span>
        </article>
        <article class="process-step">
          <span class="n">03</span>
          <h3>LoRA experiment</h3>
          <p>Validate training signal on a small leak-checked dataset.</p>
          <span class="time">5–10 days (queued) · $15</span>
        </article>
        <article class="process-step">
          <span class="n">04</span>
          <h3>Full delivery</h3>
          <p>Full training, eval, general regression, packaging, and deploy notes.</p>
          <span class="time">1–3 weeks · $45+</span>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-label"><span class="num">04</span><span class="txt">Services</span></div>
        <div class="section-head-row">
          <h2 class="h2">Start free.<br />Scale only with evidence.</h2>
          <a class="text-link" href="/en/pricing">Full pricing →</a>
        </div>
      </div>
      <PricingTable lang="en" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-panel">
        <div>
          <p class="eyebrow">LIMITED QUEUE</p>
          <h2 class="h2">Pay $0 to check fit.<br />$2 to build a ruler.</h2>
          <p class="lead">
            Limited-time queued prices run asynchronously by email. Higher-paid tiers and clearly scoped tasks take priority; regular prices skip the queue.
          </p>
        </div>
        <a class="button light" href={mailtoHref}>Free problem review <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container faq-wrap">
      <div>
        <div class="section-label"><span class="num">05</span><span class="txt">FAQ</span></div>
        <h2 class="h2">Questions,<br />answered first.</h2>
      </div>
      <FAQ items={faqs} />
    </div>
  </section>
</Layout>
